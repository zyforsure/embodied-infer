{
  "prefix_cache": {
    "enabled": true,
    "max_entries": 1024,
    "normalize": true
  },
  "vision_token_cache": {
    "enabled": true,
    "max_entries": 32,
    "prune_ratio": 0.3
  },
  "micro_pipeline": {
    "enabled": true,
    "max_in_flight": 8,
    "workers": 1
  },
  "action_quant": {
    "enabled": true,
    "sensitive_bits": 16,
    "default_bits": 8,
    "sensitive_ratio": 0.25,
    "axis": 0
  },
  "token_merge": {
    "enabled": true,
    "merge_ratio": 0.4,
    "salient_ratio": 0.1
  },
  "perception_throttle": {
    "enabled": true,
    "refresh_steps": 5,
    "refresh_interval_s": 0.0
  },
  "cascade": {
    "enabled": true,
    "difficulty_threshold": 0.5
  },
  "fused_ops": {
    "enabled": true,
    "prefer": "auto"
  }
}
